# Template for /opt/lindawiryani/env/app.env on the server (chmod 600, owned by root). Never put
# real values in this file in git. One file serves BOTH sites (main and beta): they share the
# database, secrets and the uploads volume. deploy.sh copies it into every release as `.env`.

# ── Database (compose builds DATABASE_URL from these) ──
POSTGRES_USER=lindawiryani
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lindawiryani

# Long random string (openssl rand -hex 32). Shared on purpose: both sites read the same database,
# so a login token issued by one must verify on the other.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Gmail SMTP (app password) used by /api/send-email
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Google reCAPTCHA v2. The site key is compiled into the client bundle at build time: changing it
# needs a real deploy, not apply-env.sh. Add the production domains in the reCAPTCHA admin console.
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Uploads path inside the container: a docker volume (lindawiryani_uploads), shared by both sites. The
# compose files set this themselves, so it only documents where the images live.
UPLOADS_PATH=/data/uploads

# Set to true for ONE start of main on a fresh database to load seed data, then remove it again
# (a later start would overwrite settings edited in the admin). Beta never seeds or migrates.
SEED_ON_START=
# essentials = only the admin user. Nothing else is seeded.
SEED_SCOPE=essentials
# The one admin the essentials seed creates. Put the password here for the first seed only, then
# delete the SEED_ADMIN_PASSWORD line. An account with the same email is updated to these values
# (so setting the password again and re-seeding resets it). The username is stored as its name.
SEED_ADMIN_EMAIL=admin@lindawiryani.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Beta password (the browser's sign-in popup on beta.lindawiryani.com). One shared username and
# password: whoever enters them is the team. While either is empty beta stays shut for everyone.
# lindawiryani.com does not use these. After editing run /opt/lindawiryani/bin/apply-env.sh.
TEAM_ACCESS_USERNAME=admin
TEAM_ACCESS_PASSWORD=
# How long a sign-in lasts before the popup asks again (hours; fractions allowed, default 24).
TEAM_ACCESS_SESSION_HOURS=24
