// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum WeddingExperienceHeroStyle {
  split
  centered
  editorial
  bottom
}

enum WeddingExperienceType {
  elopement_weddings    @map("elopement-weddings")
  intimate_weddings     @map("intimate-weddings")
  luxury_weddings       @map("luxury-weddings")
  private_villa_weddings @map("private-villa-weddings")
}

enum ArticleCategory {
  Guides
  Planning_Advice       @map("Planning Advice")
  Destination_Knowledge @map("Destination Knowledge")
  Venue_and_Location    @map("Venue & Location")
  Real_Weddings         @map("Real Weddings")
  Design_and_Concept    @map("Design & Concept")
}

enum SubmissionType {
  vendor
  career
}

enum SubmissionStatus {
  new
  reviewed
  contacted
  archived
}

enum InquiryStatus {
  new
  reviewed
  quoted
  booked
  archived
}

enum ContentStatus {
  draft
  published
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  role       String   @default("user") // admin | editor | user
  token_version Int   @default(0) // bump to revoke all existing JWTs
  created_at DateTime @default(now())

  @@map("users")
}

// ─────────────────────────────────────────────
// DESTINATION CATEGORY
// ─────────────────────────────────────────────

model DestinationCategory {
  id           String        @id @default(uuid())
  slug         String        @unique
  name         String
  status       ContentStatus @default(draft)
  published_at DateTime?
  sort_order   Int           @default(0)
  updated_at   DateTime      @updatedAt

  destinations Destination[]
  translations DestinationCategoryTranslation[]

  @@index([status, sort_order])
  @@map("destination_categories")
}

model DestinationCategoryTranslation {
  id          String  @id @default(uuid())
  category_id String
  locale      String
  name        String?

  category DestinationCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([category_id, locale])
  @@map("destination_category_translations")
}

// ─────────────────────────────────────────────
// DESTINATION
// ─────────────────────────────────────────────

model Destination {
  id                     String   @id @default(uuid())
  name                   String
  slug                   String   @unique
  category_id            String
  type                   String
  description            String
  long_description       String
  location               String
  atmosphere             String
  accessibility_notes    String
  seasonal_considerations String
  image                  String
  guest_capacity         String

  status       ContentStatus @default(draft)
  published_at DateTime?
  sort_order   Int           @default(0)
  updated_at   DateTime      @updatedAt

  // JSON arrays
  highlights             Json     // string[]
  best_for               Json     // string[]
  ceremony_options       Json     // string[]
  reception_options      Json     // string[]
  accommodation_nearby   Json     // string[]
  dining_experiences     Json     // string[]
  unique_features        Json     // string[]

  category   DestinationCategory @relation(fields: [category_id], references: [id])
  venues     Venue[]
  portfolios Portfolio[]
  translations DestinationTranslation[]

  @@index([category_id])
  @@index([status, sort_order])
  @@map("destinations")
}

model DestinationTranslation {
  id             String  @id @default(uuid())
  destination_id String
  locale         String

  name                    String?
  type                    String?
  description             String?
  long_description        String?
  location                String?
  atmosphere              String?
  accessibility_notes     String?
  seasonal_considerations String?
  guest_capacity          String?
  highlights              Json? // string[]
  best_for                Json? // string[]
  ceremony_options        Json? // string[]
  reception_options       Json? // string[]
  accommodation_nearby    Json? // string[]
  dining_experiences      Json? // string[]
  unique_features         Json? // string[]

  destination Destination @relation(fields: [destination_id], references: [id], onDelete: Cascade)

  @@unique([destination_id, locale])
  @@map("destination_translations")
}

// ─────────────────────────────────────────────
// WEDDING EXPERIENCE
// ─────────────────────────────────────────────

model WeddingExperience {
  id       String                @id @default(uuid())
  slug     String                @unique
  category WeddingExperienceType
  name     String

  // Section: Hero
  hero_style WeddingExperienceHeroStyle
  hero_image String
  hero_desc  String

  // Section: Intro
  intro_label      String
  intro_heading    Json    // [string, string]
  intro_body       String
  intro_list_label String?
  intro_list       Json    // string[]
  intro_footnote   String?
  intro_images     Json    // string[] — max 2 images

  // Section: Approach
  approach_label      String
  approach_heading    Json    // [string, string]
  approach_body       String
  approach_list_label String?
  approach_list       Json    // string[]
  approach_image      String

  // Section: Services
  services_label         String
  services_heading       Json    // [string, string]
  services_list          Json    // string[]
  services_footnote      String
  services_dark_label    String
  services_dark_heading  Json    // [string, string]
  services_dark_body     String
  services_dark_list     Json    // string[]

  // Section: Closing
  closing_label        String
  closing_heading      Json    // [string, string]
  closing_body         String
  closing_image        String
  closing_couple_label String?
  closing_couple_values Json   // string[]

  status       ContentStatus @default(draft)
  published_at DateTime?
  sort_order   Int           @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  faqs       ExperienceFaq[]
  venues     Venue[]
  themes     WeddingTheme[]
  portfolios Portfolio[]
  translations WeddingExperienceTranslation[]

  @@index([status, sort_order])
  @@map("wedding_experiences")
}

model WeddingExperienceTranslation {
  id            String @id @default(uuid())
  experience_id String
  locale        String

  name       String?
  hero_desc  String?

  intro_label      String?
  intro_heading    Json? // [string, string]
  intro_body       String?
  intro_list_label String?
  intro_list       Json? // string[]
  intro_footnote   String?

  approach_label      String?
  approach_heading    Json? // [string, string]
  approach_body       String?
  approach_list_label String?
  approach_list       Json? // string[]

  services_label        String?
  services_heading      Json? // [string, string]
  services_list         Json? // string[]
  services_footnote     String?
  services_dark_label   String?
  services_dark_heading Json? // [string, string]
  services_dark_body    String?
  services_dark_list    Json? // string[]

  closing_label         String?
  closing_heading       Json? // [string, string]
  closing_body          String?
  closing_couple_label  String?
  closing_couple_values Json? // string[]

  experience WeddingExperience @relation(fields: [experience_id], references: [id], onDelete: Cascade)

  @@unique([experience_id, locale])
  @@map("wedding_experience_translations")
}

// ─────────────────────────────────────────────
// EXPERIENCE FAQ
// ─────────────────────────────────────────────

model ExperienceFaq {
  id            String @id @default(uuid())
  slug          String @unique
  experience_id String
  question      String
  answer        String
  sort_order    Int    @default(0)

  experience   WeddingExperience       @relation(fields: [experience_id], references: [id], onDelete: Cascade)
  translations ExperienceFaqTranslation[]

  @@index([experience_id])
  @@map("experience_faqs")
}

model ExperienceFaqTranslation {
  id      String @id @default(uuid())
  faq_id  String
  locale  String
  question String?
  answer   String?

  faq ExperienceFaq @relation(fields: [faq_id], references: [id], onDelete: Cascade)

  @@unique([faq_id, locale])
  @@map("experience_faq_translations")
}

// ─────────────────────────────────────────────
// VENUE
// ─────────────────────────────────────────────

model Venue {
  id             String  @id @default(uuid())
  slug           String  @unique
  name           String
  slogan         String
  description    String
  image          String
  capacity       Int
  starting_price Float
  destination_id String
  experience_id  String

  status       ContentStatus @default(draft)
  published_at DateTime?
  sort_order   Int           @default(0)
  updated_at   DateTime      @updatedAt

  destination Destination       @relation(fields: [destination_id], references: [id])
  experience  WeddingExperience @relation(fields: [experience_id], references: [id])
  gallery     VenueImage[]
  themes      WeddingTheme[]
  portfolios  Portfolio[]
  translations VenueTranslation[]

  @@index([destination_id])
  @@index([experience_id])
  @@index([status, sort_order])
  @@map("venues")
}

model VenueTranslation {
  id       String  @id @default(uuid())
  venue_id String
  locale   String

  name        String?
  slogan      String?
  description String?

  venue Venue @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@unique([venue_id, locale])
  @@map("venue_translations")
}

// ─────────────────────────────────────────────
// VENUE IMAGE
// ─────────────────────────────────────────────

model VenueImage {
  id         String @id @default(uuid())
  url        String
  sort_order Int    @default(0)
  venue_id   String

  venue Venue @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@index([venue_id])
  @@map("venue_images")
}

// ─────────────────────────────────────────────
// WEDDING THEME
// ─────────────────────────────────────────────

model WeddingTheme {
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String
  description   String
  image         String
  inclusions    Json      // string[]
  venue_id      String?
  experience_id String

  status       ContentStatus @default(draft)
  published_at DateTime?
  sort_order   Int           @default(0)
  updated_at   DateTime      @updatedAt

  venue      Venue?              @relation(fields: [venue_id], references: [id])
  experience WeddingExperience  @relation(fields: [experience_id], references: [id])
  gallery    WeddingThemeImage[]
  translations WeddingThemeTranslation[]

  @@index([venue_id])
  @@index([experience_id])
  @@index([status, sort_order])
  @@map("wedding_themes")
}

model WeddingThemeTranslation {
  id       String @id @default(uuid())
  theme_id String
  locale   String

  title       String?
  description String?
  inclusions  Json? // string[]

  theme WeddingTheme @relation(fields: [theme_id], references: [id], onDelete: Cascade)

  @@unique([theme_id, locale])
  @@map("wedding_theme_translations")
}

// ─────────────────────────────────────────────
// WEDDING THEME IMAGE
// ─────────────────────────────────────────────

model WeddingThemeImage {
  id         String @id @default(uuid())
  url        String
  sort_order Int    @default(0)
  theme_id   String

  theme WeddingTheme @relation(fields: [theme_id], references: [id], onDelete: Cascade)

  @@index([theme_id])
  @@map("wedding_theme_images")
}

// ─────────────────────────────────────────────
// ARTICLE
// ─────────────────────────────────────────────

model Article {
  id           String          @id @default(uuid())
  slug         String          @unique
  category     ArticleCategory
  title        String
  excerpt      String
  published_at DateTime
  image        String
  content      String          // TipTap-serialised HTML
  status       ContentStatus   @default(draft)
  sort_order   Int             @default(0)
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt

  translations ArticleTranslation[]

  @@index([status, sort_order])
  @@map("articles")
}

model ArticleTranslation {
  id         String @id @default(uuid())
  article_id String
  locale     String

  title   String?
  excerpt String?
  content String? // TipTap-serialised HTML

  article Article @relation(fields: [article_id], references: [id], onDelete: Cascade)

  @@unique([article_id, locale])
  @@map("article_translations")
}

// ─────────────────────────────────────────────
// PORTFOLIO
// ─────────────────────────────────────────────

model Portfolio {
  id             String  @id @default(uuid())
  slug           String  @unique
  couple         String
  subtitle       String
  destination_id String?
  venue_id       String?
  experience_id  String?
  image          String
  tags           Json    // string[]
  excerpt        String
  origin         String?
  review         String?
  content        String?

  // story_sections: array of { heading?: string; body: string[] }
  story_sections Json

  // credit object
  credit_role           String
  credit_planner        String
  credit_location_detail String
  credit_couple_origin  String

  status       ContentStatus @default(draft)
  published_at DateTime?
  sort_order   Int           @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  destination Destination?       @relation(fields: [destination_id], references: [id])
  venue       Venue?             @relation(fields: [venue_id], references: [id])
  experience  WeddingExperience? @relation(fields: [experience_id], references: [id])
  gallery     PortfolioImage[]
  translations PortfolioTranslation[]

  @@index([destination_id])
  @@index([venue_id])
  @@index([experience_id])
  @@index([status, sort_order])
  @@map("portfolios")
}

model PortfolioTranslation {
  id           String @id @default(uuid())
  portfolio_id String
  locale       String

  subtitle           String?
  excerpt            String?
  origin             String?
  review             String?
  content            String?
  story_sections     Json? // { heading?: string; body: string[] }[]
  tags               Json? // string[]
  credit_role        String?
  credit_location_detail String?
  credit_couple_origin   String?

  portfolio Portfolio @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)

  @@unique([portfolio_id, locale])
  @@map("portfolio_translations")
}

// ─────────────────────────────────────────────
// PORTFOLIO IMAGE
// ─────────────────────────────────────────────

model PortfolioImage {
  id           String @id @default(uuid())
  url          String
  sort_order   Int    @default(0)
  portfolio_id String

  portfolio Portfolio @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)

  @@index([portfolio_id])
  @@map("portfolio_images")
}

// ─────────────────────────────────────────────
// SUBMISSION (Vendor & Career — single table)
// ─────────────────────────────────────────────

model Submission {
  id           String           @id @default(uuid())
  type         SubmissionType
  status       SubmissionStatus @default(new)
  submitted_at DateTime         @default(now())

  // ── Vendor fields ──────────────────────────
  company_name      String?
  contact_person    String?
  vendor_category   String?
  years_in_business String?
  portfolio_link    String?
  website           String?

  // ── Career fields ──────────────────────────
  full_name  String?
  position   String?
  experience String?
  linked_in  String?
  cover_letter String?

  // ── Shared fields ──────────────────────────
  email   String
  phone   String?
  message String?

  @@map("submissions")
}

// ─────────────────────────────────────────────
// INQUIRY SUBMISSION
// ─────────────────────────────────────────────

model InquirySubmission {
  id           String        @id @default(uuid())
  status       InquiryStatus @default(new)
  submitted_at DateTime      @default(now())

  // Contact info
  full_name         String
  email_or_whatsapp String

  // Wedding details
  wedding_date     String?
  number_of_guests String?

  // Preferences (stored as JSON string arrays)
  wedding_location_interest Json @default("[]")
  wedding_style             String?
  estimated_budget          String?
  services_needed           Json @default("[]")
  venue_secured             String?

  // Vision & discovery
  your_vision         String?
  how_did_you_find_us String?

  // Locale the inquiry was submitted in
  locale String?

  @@index([status, submitted_at])
  @@map("inquiry_submissions")
}

// ─────────────────────────────────────────────
// OPEN POSITION
// ─────────────────────────────────────────────

model OpenPosition {
  id         String   @id @default(uuid())
  slug       String   @unique
  title      String
  type       String   // "Full-time" | "Part-time / Freelance"
  level      String   // "Mid–Senior" | "Senior" | etc.
  desc       String
  is_active  Boolean  @default(true)

  status       ContentStatus @default(draft)
  published_at DateTime?
  sort_order   Int           @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  translations OpenPositionTranslation[]

  @@index([status, sort_order])
  @@map("open_positions")
}

model OpenPositionTranslation {
  id          String @id @default(uuid())
  position_id String
  locale      String
  title       String?
  type        String?
  level       String?
  desc        String?

  position OpenPosition @relation(fields: [position_id], references: [id], onDelete: Cascade)

  @@unique([position_id, locale])
  @@map("open_position_translations")
}