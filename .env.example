# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL on localhost (production: dedicated least-privilege user).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lindawiryani?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED, no fallback. Minimum 32 characters in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-random-string-of-at-least-32-characters"
JWT_EXPIRES_IN="12h"

# First admin account (used by `npm run db:seed` / `npm run db:reset-admin`).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
# ADMIN_NAME="Admin"

# ── Email (Gmail SMTP) ──────────────────────────────────────────────────────
EMAIL_USER=""
EMAIL_APP_PASSWORD=""
# Set to true only for local/staging tests: stores submissions but skips email.
EMAIL_DISABLED="false"

# ── reCAPTCHA v2 ────────────────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""

# ── Local uploads (VPS disk) ────────────────────────────────────────────────
# Local dev: ./uploads. Production: /var/lib/lindawiryani/uploads (outside the repo).
UPLOAD_DIR="./uploads"
UPLOAD_URL_BASE="/uploads"
MAX_UPLOAD_SIZE_MB="5"

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
